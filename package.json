{
  "name": "fwis",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:hosting": "tsx scripts/build-hosting-package.ts",
    "build:hosting:stage": "tsx scripts/build-hosting-package.ts stage",
    "build:hosting:prod": "tsx scripts/build-hosting-package.ts prod",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:fix-checksums": "dotenv -e .env.local -- tsx scripts/fix-migration-checksums.ts",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:migrate-behavior": "dotenv -e .env.local -- tsx scripts/migrate-behavior-scoring.ts",
    "db:backfill-student-numbers": "dotenv -e .env.local -- tsx scripts/backfill-student-numbers.ts",
    "db:encrypt-pii": "dotenv -e .env.local -- tsx scripts/encrypt-student-pii.ts",
    "db:purge": "dotenv -e .env.local -- tsx scripts/purge-database.ts",
    "db:delete-schools": "dotenv -e .env.local -- tsx scripts/delete-schools.ts",
    "setup": "tsx scripts/setup.ts",
    "import:template": "tsx scripts/generate-import-template.ts",
    "import:school": "dotenv -e .env.local -- tsx scripts/import-school-data.ts",
    "docs:credentials-pdf": "dotenv -e .env.local -- tsx scripts/generate-credentials-pdf.ts",
    "test:l1": "tsx scripts/run-l1-tests.ts",
    "test:l1:vitest": "vitest run --config vitest.config.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "papaparse": "^5.5.4",
    "pg": "^8.14.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
