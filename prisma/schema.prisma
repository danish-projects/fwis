generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRoleCode {
  NIGRA
  PRINCIPAL
  SCHOOL_ADMIN
  TEACHER
  SUBSTITUTE
  READ_ONLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EXPORT
  LOGIN
  PROMOTION
}

// --- Setup / lookup tables (reference data; seeded, not purged) ---

model Gender {
  code  String @id
  label String

  students Student[]
  staff    Staff[]
  appUsers AppUser[]

  @@map("genders")
}

model EnrollmentStatus {
  code  String @id
  label String

  enrollments StudentEnrollment[]

  @@map("enrollment_statuses")
}

model AttendanceStatus {
  code  String @id
  label String

  attendance Attendance[]

  @@map("attendance_statuses")
}

model BehaviorRating {
  code      String @id
  label     String
  sortOrder Int    @map("sort_order")

  attendance Attendance[]

  @@map("behavior_values")
}

model SessionType {
  code      String @id
  label     String
  sortOrder Int    @map("sort_order")

  calendarDays AcademicCalendarDay[]

  @@map("session_types")
}

model AssessmentType {
  code      String @id
  label     String
  sortOrder Int    @map("sort_order")

  assessmentScores AssessmentScore[]

  @@map("assessment_types")
}

model Grade {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @map("sort_order")

  classrooms Classroom[]

  @@map("grades")
}

model Section {
  id   Int    @id @default(autoincrement())
  name String @unique

  classrooms Classroom[]

  @@map("sections")
}

// --- Operational tables ---

model School {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  name          String
  address       String?
  city          String
  cityCode      String    @unique @map("city_code")
  state         String
  zipCode       String?   @map("zip_code")
  phone         String?
  email         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  academicYearSchools AcademicYearSchool[]
  classroomSchools ClassroomSchool[]
  staff         Staff[]
  enrollments   StudentEnrollment[]
  userSchools   UserSchool[]
  auditLogs     AuditLog[]
  originStudents Student[] @relation("StudentOriginSchool")

  @@unique([city, state])
  @@map("schools")
}

/** Shared classroom definition (e.g. Grade 1 Boys) — not school-specific. */
model Classroom {
  id        String    @id @default(uuid()) @db.Uuid
  gradeId   Int       @map("grade_id")
  sectionId Int       @map("section_id")
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  grade       Grade               @relation(fields: [gradeId], references: [id])
  section     Section             @relation(fields: [sectionId], references: [id])
  schoolLinks ClassroomSchool[]
  enrollments StudentEnrollment[]
  assignments StaffAssignment[]

  @@unique([gradeId, sectionId])
  @@map("classrooms")
}

/** Which schools offer a master classroom. */
model ClassroomSchool {
  id          String    @id @default(uuid()) @db.Uuid
  classroomId String    @map("classroom_id") @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  classroom Classroom @relation(fields: [classroomId], references: [id])
  school    School    @relation(fields: [schoolId], references: [id])

  @@unique([classroomId, schoolId])
  @@index([schoolId, deletedAt])
  @@map("classroom_schools")
}

model AcademicYear {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @unique
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime  @map("end_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  schoolLinks AcademicYearSchool[]
  holidays    AcademicYearHoliday[]

  @@index([deletedAt])
  @@map("academic_years")
}

model AcademicYearHoliday {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  date           DateTime  @db.Date
  name           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, date])
  @@index([academicYearId, deletedAt])
  @@map("academic_year_holidays")
}

model AcademicYearSchool {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  isActive       Boolean   @default(false) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  academicYear AcademicYear          @relation(fields: [academicYearId], references: [id])
  school       School                @relation(fields: [schoolId], references: [id])
  calendarDays AcademicCalendarDay[]
  enrollments  StudentEnrollment[]
  staffAssignments StaffAssignment[]

  @@unique([academicYearId, schoolId])
  @@index([schoolId, deletedAt])
  @@map("academic_year_schools")
}

model AcademicCalendarDay {
  id                   String   @id @default(uuid()) @db.Uuid
  academicYearSchoolId String   @map("academic_year_school_id") @db.Uuid
  date                 DateTime @db.Date
  lessonPlanNumber     Int?     @map("lesson_plan_number")
  sessionType          String   @default("INSTRUCTIONAL") @map("session_type")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  academicYearSchool AcademicYearSchool @relation(fields: [academicYearSchoolId], references: [id])
  sessionTypeLookup  SessionType        @relation(fields: [sessionType], references: [code])
  attendance         Attendance[]

  @@unique([academicYearSchoolId, date])
  @@index([academicYearSchoolId, deletedAt])
  @@map("academic_calendar_days")
}

model Student {
  id               String    @id @default(uuid()) @db.Uuid
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  studentNumber    String?   @unique @map("student_number")
  gender           String
  dateOfBirth      String?   @map("date_of_birth")
  dateOfBirthHash  String?   @map("date_of_birth_hash")
  emailAddress     String?   @map("email_address")
  emergencyContact String?   @map("emergency_contact")
  streetAddress    String?   @map("street_address")
  city             String?
  stateProvince    String?   @map("state_province")
  zipPostalCode    String?   @map("zip_postal_code")
  country          String?
  fatherGuardianFirstName       String?  @map("father_guardian_first_name")
  fatherGuardianLastName        String?  @map("father_guardian_last_name")
  fatherParentalResponsibility  Boolean? @map("father_parental_responsibility")
  fatherMobileWhatsappNumber    String?  @map("father_mobile_whatsapp_number")
  fatherMobileWhatsappHash      String?  @map("father_mobile_whatsapp_hash")
  motherGuardianFirstName       String?  @map("mother_guardian_first_name")
  motherGuardianLastName        String?  @map("mother_guardian_last_name")
  motherParentalResponsibility  Boolean? @map("mother_parental_responsibility")
  motherMobileWhatsappNumber    String?  @map("mother_mobile_whatsapp_number")
  motherMobileWhatsappHash      String?  @map("mother_mobile_whatsapp_hash")
  enrollmentDate   DateTime  @default(now()) @map("enrollment_date") @db.Date
  originSchoolId   String?   @map("origin_school_id") @db.Uuid
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  genderLookup Gender              @relation(fields: [gender], references: [code])
  originSchool School?             @relation("StudentOriginSchool", fields: [originSchoolId], references: [id])
  enrollments  StudentEnrollment[]

  @@index([lastName, firstName])
  @@index([originSchoolId])
  @@index([dateOfBirthHash])
  @@index([fatherMobileWhatsappHash])
  @@index([motherMobileWhatsappHash])
  @@map("students")
}

model StudentNumberSequence {
  cityCode     String @map("city_code")
  genderPrefix String @map("gender_prefix")
  lastNumber   Int    @default(0) @map("last_number")

  @@id([cityCode, genderPrefix])
  @@map("student_number_sequences")
}

model Staff {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  /** Login handle — FK to app_users.user_id (not app_users.id). */
  userId    String?   @unique @map("user_id")
  gender    String
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  /** Contact / communication email (not used for login). */
  email     String
  phone     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school      School              @relation(fields: [schoolId], references: [id])
  genderRef   Gender              @relation(fields: [gender], references: [code])
  user        AppUser?            @relation(fields: [userId], references: [userId], onUpdate: Cascade, onDelete: SetNull)
  assignments StaffAssignment[]
  enrollments StudentEnrollment[]

  @@unique([schoolId, email])
  @@map("staff")
}

/** Role + classroom for a staff member within one school academic year. */
model StaffAssignment {
  id                   String  @id @default(uuid()) @db.Uuid
  staffId              String  @map("staff_id") @db.Uuid
  academicYearSchoolId String  @map("academic_year_school_id") @db.Uuid
  roleId               Int     @map("role_id")
  /** Null for Nigran / Principal / Substitute without a single grade. */
  classroomId          String? @map("classroom_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  staff              Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  academicYearSchool AcademicYearSchool @relation(fields: [academicYearSchoolId], references: [id], onDelete: Cascade)
  role               Role               @relation(fields: [roleId], references: [id])
  classroom          Classroom?         @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@unique([staffId, academicYearSchoolId])
  @@unique([academicYearSchoolId, classroomId])
  @@index([academicYearSchoolId])
  @@map("staff_assignments")
}

model StudentEnrollment {
  id                   String   @id @default(uuid()) @db.Uuid
  studentId            String   @map("student_id") @db.Uuid
  schoolId             String   @map("school_id") @db.Uuid
  academicYearSchoolId String   @map("academic_year_school_id") @db.Uuid
  classroomId          String   @map("classroom_id") @db.Uuid
  staffId              String?  @map("staff_id") @db.Uuid
  enrollmentDate       DateTime @default(now()) @map("enrollment_date") @db.Date
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  student              Student              @relation(fields: [studentId], references: [id])
  school               School               @relation(fields: [schoolId], references: [id])
  academicYearSchool   AcademicYearSchool   @relation(fields: [academicYearSchoolId], references: [id])
  classroom            Classroom            @relation(fields: [classroomId], references: [id])
  staff                Staff?               @relation(fields: [staffId], references: [id])
  statusLookup         EnrollmentStatus     @relation(fields: [status], references: [code])
  attendance           Attendance[]
  assessments          AssessmentScore[]
  finalGrade           EnrollmentFinalGrade?

  @@unique([studentId, academicYearSchoolId])
  @@index([schoolId, academicYearSchoolId])
  @@index([classroomId])
  @@index([classroomId, academicYearSchoolId, status])
  @@map("student_enrollments")
}

model Attendance {
  id               String    @id @default(uuid()) @db.Uuid
  enrollmentId     String    @map("enrollment_id") @db.Uuid
  calendarDayId    String    @map("calendar_day_id") @db.Uuid
  status           String
  behaviorValue    String?   @map("behavior_value")
  behaviorComments String?   @map("behavior_comments")
  teacherComments  String?   @map("teacher_comments")
  recordedById     String?   @map("recorded_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  enrollment           StudentEnrollment @relation(fields: [enrollmentId], references: [id])
  calendarDay          AcademicCalendarDay @relation(fields: [calendarDayId], references: [id])
  statusLookup         AttendanceStatus  @relation(fields: [status], references: [code])
  behaviorValueLookup BehaviorRating?   @relation(fields: [behaviorValue], references: [code])
  recordedBy           AppUser?          @relation(fields: [recordedById], references: [id])

  @@unique([enrollmentId, calendarDayId])
  @@index([enrollmentId, deletedAt])
  @@index([calendarDayId])
  @@map("attendance")
}

model AssessmentScore {
  id           String    @id @default(uuid()) @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  type         String
  score        Decimal   @db.Decimal(5, 2)
  recordedById String?   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  enrollment     StudentEnrollment @relation(fields: [enrollmentId], references: [id])
  typeLookup     AssessmentType    @relation(fields: [type], references: [code])
  recordedBy     AppUser?          @relation(fields: [recordedById], references: [id])

  @@unique([enrollmentId, type])
  @@index([enrollmentId, deletedAt])
  @@map("assessment_scores")
}

model EnrollmentFinalGrade {
  enrollmentId  String   @id @map("enrollment_id") @db.Uuid
  attendancePct Decimal  @map("attendance_pct") @db.Decimal(5, 2)
  behaviorPct   Decimal  @map("behavior_pct") @db.Decimal(5, 2)
  finalPct      Decimal  @map("final_pct") @db.Decimal(5, 2)
  letterGrade   String   @map("letter_grade")
  passFail      String   @map("pass_fail")
  classRank     Int?     @map("class_rank")
  computedAt    DateTime @default(now()) @map("computed_at")

  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id])

  @@map("enrollment_final_grades")
}

model GradingScaleConfig {
  id          String   @id @default("global")
  weights     Json
  letterBands Json     @map("letter_bands")
  passMinPct  Decimal  @default(70) @map("pass_min_pct") @db.Decimal(5, 2)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy AppUser? @relation(fields: [updatedById], references: [id])

  @@map("grading_scale_config")
}

model Role {
  id   Int          @id @default(autoincrement())
  code UserRoleCode @unique
  name String

  userRoles   UserRole[]
  assignments StaffAssignment[]

  @@map("roles")
}

model AppUser {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id")
  passwordHash String?  @map("password_hash")
  fullName     String?  @map("full_name")
  gender       String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  genderRef Gender? @relation(fields: [gender], references: [code])

  roles               UserRole[]
  schools             UserSchool[]
  staff               Staff?
  auditLogs           AuditLog[]
  attendance          Attendance[]
  assessments         AssessmentScore[]
  gradingScaleUpdates GradingScaleConfig[]

  @@map("app_users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId Int    @map("role_id")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserSchool {
  userId   String @map("user_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, schoolId])
  @@map("user_schools")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  schoolId  String?     @map("school_id") @db.Uuid
  entity    String
  entityId  String?     @map("entity_id") @db.Uuid
  action    AuditAction
  oldValues Json?       @map("old_values")
  newValues Json?       @map("new_values")
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  user   AppUser? @relation(fields: [userId], references: [id])
  school School?  @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}
