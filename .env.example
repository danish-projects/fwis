# Copy this file to .env.local and fill in your values.

# PostgreSQL — SmarterASP.NET (use the same URL for app + Prisma CLI)
# Encode special characters in the password (@ → %40, etc.)
# SmarterASP: use port 6432 (external 5432 typically times out)
DATABASE_URL="postgresql://USERNAME:PASSWORD@PGxxxx.site4now.net:6432/db_xxxxx_fwis?sslmode=require"
DIRECT_URL="postgresql://USERNAME:PASSWORD@PGxxxx.site4now.net:6432/db_xxxxx_fwis?sslmode=require"

# Signed session cookie — generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=""

# Initial super admin login user id (created by npm run db:seed). No @fwis.org suffix.
SEED_SUPER_ADMIN_USER_ID="majlis"
# Legacy alias still accepted (domain is stripped): SEED_SUPER_ADMIN_EMAIL="majlis"
# Suggested default: FwisMajlis786!
SEED_SUPER_ADMIN_PASSWORD=""

# Optional — override default passwords created with “Create default app users”
# DEFAULT_PRINCIPAL_PASSWORD="FwisPrincipal786!"
# DEFAULT_ADMIN_PASSWORD="FwisAdmin786!"
# DEFAULT_TEACHER_PASSWORD="FwisTeacher786!"
# DEFAULT_SUBSTITUTE_PASSWORD="FwisSub786!"
# Legacy alias for teacher password:
# IMPORT_TEACHER_DEFAULT_PASSWORD="FwisTeacher786!"

# Public site URL — MUST match your live URL before `npm run build:hosting`
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Deployed environment label shown in the sidebar with the app version
# (local | stage | prod). Baked into the client at build time.
# Local: leave unset or use "local". Hosting: set in .env.stage / .env.prod.
# NEXT_PUBLIC_APP_ENV="local"

# Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=""

# School calendar timezone for “today”, attendance defaults, and year selection.
# FWIS uses US Central (CST/CDT). Do not leave this as UTC/Pacific on the host.
# SCHOOL_TIMEZONE="America/Chicago"
# TZ="America/Chicago"

# Optional — absent-parent email notifications
# RESEND_API_KEY=""
# EMAIL_FROM="FWIS <notifications@yourdomain.com>"

# Optional — Google Drive lesson plans / course materials (required on hosting for Lesson Plans)
# Prefer split vars on SmarterASP (multiline JSON often breaks in the panel):
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL="fwis-docs@….iam.gserviceaccount.com"
# GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
# Or full JSON (works in a .env file uploaded next to server.js):
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Parent FWIS Docs folder ID (year folders are found by academic year name under this parent)
# GOOGLE_DRIVE_FWIS_DOCS_FOLDER_ID="1ABCdefGHIjkLmNoPqRsTuVwXyZ"

# Optional — allow relaxed SSL verification on shared Postgres hosts (default: relaxed)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
